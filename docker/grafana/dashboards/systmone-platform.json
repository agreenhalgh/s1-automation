    {
      "type": "timeseries",
      "id": 114,
      "title": "Buffer cache hit ratio",
      "description": "Reads served from shared buffers rather than from disk. Run history and the audit log only grow, so a slow decline here is queries reaching further back through a bigger table.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(pg_stat_database_blks_hit{datname=\"systmone\"}[30m])\n  / (rate(pg_stat_database_blks_hit{datname=\"systmone\"}[30m])\n     + rate(pg_stat_database_blks_read{datname=\"systmone\"}[30m]))",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "hit ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 4,
            "gradientMode": "opacity",
            "spanNulls": true,
            "showPoints": "never",
            "pointSize": 5,
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
