    {
      "type": "timeseries",
      "id": 109,
      "title": "Broker message rates",
      "description": "Published, delivered and acknowledged across the node. A worker acks only after the control plane has recorded the outcome, so delivered running ahead of acked is expected under load; sustained divergence is not. Redelivered above zero means a worker died mid-run and another picked the job up.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(rabbitmq_queue_messages_published_total{job=\"rabbitmq\"}[$__rate_interval]))",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "published"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(rabbitmq_queue_messages_delivered_total{job=\"rabbitmq\"}[$__rate_interval]))",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "delivered"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(rabbitmq_queue_messages_acked_total{job=\"rabbitmq\"}[$__rate_interval]))",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "acked"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(rabbitmq_queue_messages_redelivered_total{job=\"rabbitmq\"}[$__rate_interval]))",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "redelivered"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
