    {
      "type": "timeseries",
      "id": 9,
      "title": "Run outcomes per hour",
      "description": "Terminal runs by status, scaled to an hourly rate, against the dispatch rate. Counted at the transition in ResultService, so a redelivered duplicate report cannot inflate it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (rate(systmone_runs_finished_total{bot=~\"$bot\"}[$__rate_interval])) * 3600",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "{{status}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(systmone_runs_dispatched_total{bot=~\"$bot\"}[$__rate_interval])) * 3600",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "dispatched"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "spanNulls": true,
            "showPoints": "never",
            "pointSize": 5,
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "Success rate by bot",
      "description": "SUCCEEDED as a share of all terminal runs, over a rolling hour. A bot sliding here before it starts failing outright is usually a locator drifting - see the fallback rate below.\n\nThe 'or' clause grafts on a zero series for bots with no successes in the window: without it the numerator has no series to match, the division yields nothing, and a bot that has failed every single run reads as 'No data' rather than as 0%.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (bot) (rate(systmone_runs_finished_total{status=\"SUCCEEDED\",bot=~\"$bot\"}[1h]))\n   or sum by (bot) (0 * rate(systmone_runs_finished_total{bot=~\"$bot\"}[1h])))\n  / sum by (bot) (rate(systmone_runs_finished_total{bot=~\"$bot\"}[1h]))",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "{{bot}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "opacity",
            "spanNulls": true,
            "showPoints": "never",
            "pointSize": 5,
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "Run duration",
      "description": "Timed from startedAt - when a worker actually picked the run up - so queue wait is not counted as execution time. p95 is the number to watch: a mean hides the run that sat four minutes on one locator.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(systmone_run_duration_seconds_bucket{bot=~\"$bot\"}[30m])))",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(systmone_run_duration_seconds_bucket{bot=~\"$bot\"}[30m])))",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "p50"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(systmone_run_duration_seconds_sum{bot=~\"$bot\"}[30m]))\n  / sum(rate(systmone_run_duration_seconds_count{bot=~\"$bot\"}[30m]))",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "mean"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "opacity",
            "spanNulls": true,
            "showPoints": "never",
            "pointSize": 5,
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "bargauge",
      "id": 12,
      "title": "Non-success runs, last 24h",
      "description": "Every terminal state that is not SUCCEEDED, by bot - FAILED, ABORTED and TIMED_OUT together, because from an operator's point of view all three are a run that did not do its job.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (bot) (increase(systmone_runs_finished_total{status!=\"SUCCEEDED\",bot=~\"$bot\"}[24h]))",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "legendFormat": "{{bot}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
