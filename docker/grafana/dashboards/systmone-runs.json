{
  "uid": "systmone-runs",
  "title": "SystmOne - Bot runs",
  "description": "What the bots are doing: dispatch and outcome per bot, run and step durations, and the locator-fallback rate that says whether the definitions still fit the screen. The counters start empty on a fresh control plane and appear on the first run.",
  "tags": [
    "systmone"
  ],
  "editable": true,
  "graphTooltip": 1,
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "weekStart": "",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "bot",
        "label": "Bot",
        "description": "Filters the run panels. Empty until a run has finished: Micrometer creates a counter on first increment, so nothing labels itself before then.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(systmone_runs_finished_total, bot)",
        "query": {
          "qryType": 1,
          "query": "label_values(systmone_runs_finished_total, bot)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "sort": 1,
        "hide": 0,
        "options": [],
        "skipUrlSync": false,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "worker",
        "label": "Workstation",
        "description": "Filters the step and locator panels to one or more agents.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(systmone_worker_jobs_active, worker)",
        "query": {
          "qryType": 1,
          "query": "label_values(systmone_worker_jobs_active, worker)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "sort": 1,
        "hide": 0,
        "options": [],
        "skipUrlSync": false,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Right now",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Runs in flight",
      "description": "PENDING + DISPATCHED + RUNNING. Non-zero is normal; non-zero and flat for minutes is not, because it means nothing is consuming the queue.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(systmone_runs_inflight)",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
