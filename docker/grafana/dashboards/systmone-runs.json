        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "showPercentChange": false,
        "wideLayout": true
      }
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Workers idle",
      "description": "Agents the control plane last heard from as IDLE. Zero means every workstation is busy, so the next dispatch waits in the queue.",
