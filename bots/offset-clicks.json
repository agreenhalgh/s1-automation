{
  "botId": "offset-clicks",
  "name": "Reference bot — every way to click at an offset",
  "version": 1,
  "s1Version": "2024",
  "globalTimeoutMs": 60000,
  "steps": [
    {
      "index": 0,
      "name": "A. Click 40px right of the Save icon (offset from the matched element's CENTRE)",
      "action": "CLICK",
      "timeoutMs": 8000,
      "clickOffsetX": 40,
      "clickOffsetY": 0,
      "locatorChain": [
        { "type": "IMAGE", "templateRef": "toolbar-save", "threshold": 0.95 }
      ]
    },
    {
      "index": 1,
      "name": "B. Type into the box right of a label (anchor-relative point, offset from the anchor's TOP-LEFT)",
      "action": "SET_TEXT",
      "inputValue": "${nhsNumber}",
      "timeoutMs": 8000,
      "locatorChain": [
        { "type": "IMAGE", "anchorTemplateRef": "label-nhs-number", "offsetX": 130, "offsetY": 8, "threshold": 0.94 }
      ]
    },
    {
      "index": 2,
      "name": "C. Tick a checkbox at an anchor offset, click point centred on the template's size",
      "action": "CLICK",
      "timeoutMs": 8000,
      "locatorChain": [
        {
          "type": "IMAGE",
          "anchorTemplateRef": "consent-panel-header",
          "templateRef": "checkbox-unticked",
          "offsetX": 12,
          "offsetY": 44,
          "threshold": 0.95
        }
      ]
    },
    {
      "index": 3,
      "name": "D. Combined — anchor offset picks the row, step offset picks the column",
      "action": "CLICK",
      "timeoutMs": 8000,
      "clickOffsetX": 220,
      "clickOffsetY": 0,
      "locatorChain": [
        {
          "type": "IMAGE",
          "anchorTemplateRef": "results-grid-header",
          "templateRef": "grid-row-strip",
          "offsetX": 0,
          "offsetY": 74,
          "threshold": 0.93
        }
      ]
    },
    {
      "index": 4,
      "name": "E. Right-click 15px below a row anchor to raise its context menu",
      "action": "RIGHT_CLICK",
      "timeoutMs": 8000,
      "locatorChain": [
        { "type": "IMAGE", "anchorTemplateRef": "results-grid-header", "offsetX": 80, "offsetY": 30, "threshold": 0.93 }
      ]
    },
    {
      "index": 5,
      "name": "F. Click the menu item (JAB first — no offset needed once the element is addressable)",
      "action": "CLICK",
      "timeoutMs": 8000,
      "locatorChain": [
        { "type": "JAB", "role": "menu item", "name": "Open Patient Record", "nameMatch": "EXACT" },
        { "type": "IMAGE", "templateRef": "menu-open-patient-record", "threshold": 0.95 }
      ]
    },
    {
      "index": 6,
      "name": "G. Hover 18px ABOVE a control (negative offset) to reveal its tooltip",
      "action": "HOVER",
      "timeoutMs": 5000,
      "clickOffsetX": 0,
      "clickOffsetY": -18,
      "locatorChain": [
        { "type": "IMAGE", "templateRef": "toolbar-appointments", "threshold": 0.95 }
      ]
    },
    {
      "index": 7,
      "name": "H. Drag a slot 120px down — for DRAG the offset is the delta, not a click point",
      "action": "DRAG",
      "timeoutMs": 8000,
      "clickOffsetX": 0,
      "clickOffsetY": 120,
      "locatorChain": [
        { "type": "IMAGE", "templateRef": "appt-slot-1030", "threshold": 0.95 }
      ]
    },
    {
      "index": 8,
      "name": "I. Offsets are ignored by JAB — use an IMAGE-only chain when the offset matters",
      "action": "CLICK",
      "timeoutMs": 8000,
      "clickOffsetX": 0,
      "clickOffsetY": 26,
      "locatorChain": [
        { "type": "IMAGE", "templateRef": "expander-arrow", "threshold": 0.95 }
      ]
    }
  ]
}
